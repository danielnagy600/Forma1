@model TeamViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="YearOfFoundation" class="form-label"></label>
    <input asp-for="YearOfFoundation" class="form-control" />
    <span asp-validation-for="YearOfFoundation" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="WonOfChampionship" class="form-label"></label>
    <input asp-for="WonOfChampionship" class="form-control" />
    <span asp-validation-for="WonOfChampionship" class="text-danger"></span>
</div>
<div class="mb-3 form-check">
    <input asp-for="IsPaid" class="form-check-input" />
    <label asp-for="IsPaid" class="form-check-label"></label>
</div>
